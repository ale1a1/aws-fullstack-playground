# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# ── Local PostgreSQL (used when USE_RDS = false in src/db.ts) ──────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/nestdb

# ── AWS RDS (used when USE_RDS = true in src/db.ts) ───────────────────────
# Get this from your RDS instance → Connectivity & security → Endpoint
RDS_URL=postgresql://postgres:yourpassword@your-rds-endpoint.rds.amazonaws.com:5432/postgres

# ── AWS SES sender (used when deploying Lambda via serverless deploy) ──────
# Must be a verified identity in AWS SES
SENDER_EMAIL=your-verified-sender@yourdomain.com
